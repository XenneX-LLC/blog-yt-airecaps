---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  pubDate?: Date;
  updatedDate?: Date;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image,
  canonicalURL,
  pubDate,
  updatedDate,
  type = 'website',
} = Astro.props;

const siteURL = 'https://airecaps.com';
const siteName = 'AI Recaps';
// With base='/blog' and pages under src/pages/blog/, Astro.url.pathname becomes
// /blog/blog/... during static build — deduplicate the doubled /blog prefix.
const deduplicatedPath = Astro.url.pathname.replace(/^\/blog\/blog/, '/blog');
const canonical = canonicalURL || (siteURL + deduplicatedPath);
// Resolve post images to absolute URLs for scrapers. The fallback is the main
// site's OG image; there is no og-default.png on airecaps.com.
const defaultImage = `${siteURL}/assets/images/screenshots/desktop-summary-detail-dark.png`;
const ogImage = image ? new URL(image, Astro.site ?? siteURL).href : defaultImage;
const fullTitle = `${title} | ${siteName} Blog`;

const jsonLD = {
  "@context": "https://schema.org",
  "@type": type === 'article' ? "BlogPosting" : "WebSite",
  "headline": title,
  "description": description,
  "url": canonical,
  ...(type === 'article' && {
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
    "image": [ogImage]
  }),
  ...(pubDate && { "datePublished": pubDate.toISOString() }),
  ...((updatedDate || pubDate) && { "dateModified": (updatedDate || pubDate)!.toISOString() }),
  "author": {
    "@type": "Organization",
    "name": siteName,
    "url": siteURL
  },
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "url": siteURL,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteURL}/assets/icon/icon-512x512.png`
    }
  }
};
---

<!-- Primary Meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={siteName} />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title={`${siteName} Blog RSS`} href="/blog/rss.xml" />

<!-- Sitemap -->
<link rel="sitemap" type="application/xml" href="/blog/sitemap-index.xml" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
